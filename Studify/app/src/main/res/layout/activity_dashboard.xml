<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <include layout="@layout/header_common"/>

                <LinearLayout
                    android:id="@+id/priority_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_priority_card"
                    android:padding="16dp"
                    android:layout_marginTop="22dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/priority_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGH PRIORITY !!!"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/priority_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="CSC264 INDIVIDUAL PROJECT"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/priority_datetime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="19 JUNE 2026 · 12 AM"
                        android:textColor="@color/white"
                        android:textSize="13sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/priority_location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="UFUTURE"
                            android:textColor="@color/white"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/priority_done_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DONE ✓"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:background="@drawable/bg_status_pill"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="OVERVIEW"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"/>

                <TextView
                    android:id="@+id/tv_empty_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="No tasks yet. Tap Create to add your first assignment or test!"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/section_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TEST"
                        android:textColor="@color/accent_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_tasks_test"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/section_assignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ASSIGNMENT"
                        android:textColor="@color/spotify_green"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_tasks_assignment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/bottom_nav"/>

</LinearLayout>
