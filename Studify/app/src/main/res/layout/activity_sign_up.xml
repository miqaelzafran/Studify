<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181A1F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/studify_logo"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="20dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set up your study schedule"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="30dp"/>

        <ImageView
            android:id="@+id/iv_signup_photo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_person"
            android:background="@drawable/rounded_input"
            android:padding="20dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/btn_signup_add_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Profile Photo *"
            android:textColor="#00C853"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/register_name"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_input"
            android:hint="What do we call you?"
            android:inputType="textPersonName"
            android:paddingStart="20dp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/register_email"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_input"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/register_username"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_input"
            android:hint="Username"
            android:inputType="text"
            android:paddingStart="20dp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/register_password"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_input"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/register_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_input"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semester Weeks"
            android:textColor="#999999"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="5dp"
            android:layout_gravity="start"
            android:paddingStart="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/rounded_input"
            android:layout_marginBottom="15dp"
            android:padding="5dp">

            <Button
                android:id="@+id/btn_minus_week"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:backgroundTint="#E0E0E0"
                android:text="-"
                android:textColor="#333333"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"/>

            <TextView
                android:id="@+id/tv_week_count"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="14"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <Button
                android:id="@+id/btn_plus_week"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:backgroundTint="#E0E0E0"
                android:text="+"
                android:textColor="#333333"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semester Start Date"
            android:textColor="#999999"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="5dp"
            android:layout_gravity="start"
            android:paddingStart="10dp"/>

        <EditText
            android:id="@+id/register_start_date"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_input"
            android:hint="Tap to select the first day of Week 1"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            android:paddingStart="20dp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/register_submit_button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#00C853"
            android:text="CREATE ACCOUNT"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            app:cornerRadius="15dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>