<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <include layout="@layout/header_common"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CREATE TASK"
                android:textColor="@color/spotify_green"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <EditText
                android:id="@+id/input_title"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_input"
                android:hint="Title (e.g. CSC264 Lab Test)"
                android:paddingStart="20dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Type"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>

            <RadioGroup
                android:id="@+id/type_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radio_assignment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assignment"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/spotify_green"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/radio_test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="Test"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/spotify_green"/>
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Date"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/input_date"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_input"
                android:hint="Tap to choose date"
                android:paddingStart="20dp"
                android:focusable="false"
                android:clickable="true"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Time"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/input_time"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_input"
                android:hint="Tap to choose time"
                android:paddingStart="20dp"
                android:focusable="false"
                android:clickable="true"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Notes / Location"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/input_location"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_input"
                android:hint="e.g. B3004 or Google Classroom"
                android:paddingStart="20dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="30dp"
                android:text="SAVE TASK"
                android:textColor="#000000"
                android:textStyle="bold"
                android:backgroundTint="@color/spotify_green"/>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav"/>
</LinearLayout>
