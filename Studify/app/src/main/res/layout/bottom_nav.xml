<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/bg_nav"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:weightSum="5">

    <LinearLayout android:id="@+id/nav_home" style="@style/NavItem">
        <ImageView android:id="@+id/nav_home_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home"/>
        <TextView android:id="@+id/nav_home_text" style="@style/NavText" android:text="Home"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_search" style="@style/NavItem">
        <ImageView android:id="@+id/nav_search_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_search"/>
        <TextView android:id="@+id/nav_search_text" style="@style/NavText" android:text="Search"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_create" style="@style/NavItem">
        <ImageView android:id="@+id/nav_create_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_add"/>
        <TextView android:id="@+id/nav_create_text" style="@style/NavText" android:text="Create"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_task" style="@style/NavItem">
        <ImageView android:id="@+id/nav_task_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_task"/>
        <TextView android:id="@+id/nav_task_text" style="@style/NavText" android:text="Task"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/nav_me" style="@style/NavItem">
        <ImageView android:id="@+id/nav_me_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_person"/>
        <TextView android:id="@+id/nav_me_text" style="@style/NavText" android:text="Me"/>
    </LinearLayout>

</LinearLayout>
